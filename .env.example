RTMC_ENVIRONMENT=local
RTMC_LOG_LEVEL=INFO
RTMC_PRIVACY_NOTICE_VERSION=demo-privacy-v1
GOVERNED_COMPLAINT_WORKFLOW_ENABLED=false
GOVERNED_CONSENT_WORDING_VERSION=synthetic-consent-v1
LLM_GENERATION_LIMIT_PER_SESSION=10
LLM_QUOTA_WINDOW_SECONDS=86400
REQUEST_RATE_LIMIT_PER_MINUTE=20
# Optional durable audit log (KPI storage). Empty = in-memory (no database).
# Docker Compose sets postgresql://rtmc:rtmc@db:5432/rtmc automatically.
DATABASE_URL=
APPROVED_SUPPORT_PHONE=
APPROVED_CONTACT_URL=
# mock (default, deterministic, no network call) | openai (disabled without a
# key) | ollama (self-hosted local inference, no external API — see
# docs/LOCAL_LLM.md). To try Ollama locally: set LLM_PROVIDER=ollama and raise
# LLM_TIMEOUT_SECONDS to 60 (local CPU inference is slower than the 15s default).
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=500
LLM_MAX_RETRIES=1
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Self-hosted local inference via Ollama (only used when LLM_PROVIDER=ollama).
# Native/local execution default; Docker overrides this to host.docker.internal
# automatically (see compose.yaml). No API key is required or used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Telegram channel (optional). Get a token from @BotFather, then run:
#   python scripts/telegram_polling.py   (needs the API running)
TELEGRAM_BOT_TOKEN=
