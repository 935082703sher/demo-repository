ily:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-4518643" id="-4518643">Oʻzbekiston Respublikasi Vazirlar Mahkamasining</div></div><div class="ACT_FORM"><div name="-4518648" id="-4518648">qarori</div></div><div class="ACT_TITLE"><div name="-4518649" id="-4518649">Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan mobil qurilmalarni roʻyxatga olish tartibi toʻgʻrisidagi nizomni tasdiqlash haqida</div></div><div class="BY_DEFAULT"><div name="-4518652" id="-4518652"></div></div><div class="ACT_TEXT"><div name="-4518653" id="-4518653">Oʻzbekiston Respublikasi Vazirlar Mahkamasining “Oʻzbekiston Respublikasida mobil qurilmalarni hisobga olish tizimini tartibga solish chora-tadbirlari toʻgʻrisida” 2018-yil 22-oktabrdagi 847-son <a href="https://lex.uz/ru/docs/-4015704">qaroriga</a> muvofiq, shuningdek, Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan mobil qurilmalarni roʻyxatga olish tartibi va shartlarini belgilash maqsadida Vazirlar Mahkamasi qaror qiladi:</div></div><div class="ACT_TEXT"><div name="-4518654" id="-4518654">1. Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan mobil qurilmalarni roʻyxatga olish tartibi toʻgʻrisidagi nizom (keyingi oʻrinlarda Nizom deb ataladi) <a href="https://lex.uz/ru/docs/-4517458#-4518674">ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-4518658" id="-4518658">2. Belgilansinki:</div></div><div class="ACT_TEXT"><div name="-4518659" id="-4518659">Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan mobil qurilmalar mobil qurilmalarni xalqaro oʻziga xos identifikatsiya kodlari boʻyicha roʻyxatga olish tizimida:</div></div><div class="ACT_TEXT"><div name="-4518661" id="-4518661">2019-yil 1-noyabrgacha — ularni avtomatik tarzda mobil aloqa operatorlari tarmoqlariga ulash (aktivlashtirish) orqali bepul asosda;</div></div><div class="ACT_TEXT"><div name="-4518662" id="-4518662">2019-yil 1-noyabrdan — Nizomga muvofiq jismoniy shaxslar, import qiluvchilar va ishlab chiqaruvchi korxonalarning mobil qurilmalarni xalqaro oʻziga xos identifikatsiya kodlari boʻyicha roʻyxatga olish tizimiga murojaat qilishi orqali bepul asosda;</div></div><div class="ACT_TEXT"><div name="-4518663" id="-4518663">2019-yil 1-dekabrdan — Nizomga muvofiq jismoniy shaxslar, import qiluvchilar va ishlab chiqaruvchi tashkilotlarning mobil qurilmalarni xalqaro oʻziga xos identifikatsiya kodlari boʻyicha roʻyxatga olish tizimiga murojaat qilishi orqali pulli asosda roʻyxatga olinadi.</div></div><div class="ACT_TEXT"><div name="-4518664" id="-4518664">3. Oʻzbekiston Respublikasi Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi hamda Oʻzbekiston Respublikasi Vazirlar Mahkamasi huzuridagi Davlat personallashtirish markazi jismoniy shaxslar tomonidan shaxsiy foydalanish uchun olib kiriladigan mobil qurilmalarni roʻyxatga olish maqsadida mobil qurilmalarni xalqaro oʻziga xos identifikatsiya kodlari boʻyicha roʻyxatga olish tizimi operatorining Vazirlar Mahkamasi huzuridagi Davlat personallashtirish markazi bilan oʻzaro hamkorligi toʻgʻrisida bitim tuzilishini hamda fuqarolarning Oʻzbekiston Respublikasi Davlat chegarasini kesib oʻtganligi haqidagi maʼlumotlar bilan avtomatik tarzda almashish uchun ularning elektron tizimlariga ulanishini bir oy muddatda taʼminlasin.</div></div><div class="BY_DEFAULT"><div name="-6649278" id="-6649278"></div></div><div class="ACT_TEXT"><div name="-6649279" id="-6649279">4. Oʻzbekiston Respublikasi Raqamli texnologiyalar vazirligi Oʻzbekiston Milliy teleradiokompaniyasi, Oʻzbekiston Milliy axborot agentligi, Transport vazirligi bilan birgalikda bosma va elektron ommaviy axborot vositalarini jalb qilgan holda, ushbu qarorning maqsad va vazifalarini aholi, turistlar va respublika mehmonlari oʻrtasida keng yoritib borilishini tizimli asosda tashkil qilsin.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649280" id="-6649280">(4-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645753">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="ACT_TEXT"><div name="-4518666" id="-4518666">5. Oʻzbekiston Respublikasi Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi manfaatdor vazirliklar hamda idoralar bilan birgalikda oʻzlari qabul qilgan normativ-huquqiy hujjatlarni bir oy muddatda ushbu qarorga muvofiqlashtirsin.</div></div><div class="ACT_TEXT"><div name="-4518673" id="-4518673">6. Mazkur qarorning bajarilishini nazorat qilish Oʻzbekiston Respublikasi axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vaziri Sh.M. Sadikov zimmasiga va Oʻzbekiston Respublikasi Vazirlar Mahkamasining Telekommunikatsiyalar, IT-texnologiyalar va innovatsion faoliyatni rivojlantirish, axborot xavfsizligini taʼminlash masalalari kotibiyatiga yuklansin.</div></div><div class="SIGNATURE"><div name="-4518676" id="-4518676">Oʻzbekiston Respublikasining Bosh vaziri A. ARIPOV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4518678" id="-4518678">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4518680" id="-4518680">2019-yil 17-sentabr,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-4518682" id="-4518682">778-son</div></div><div class="BY_DEFAULT"><div name="-4518674" id="-4518674"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4518690" id="-4518690">Vazirlar Mahkamasining 2019-yil 17-sentabrdagi 778-son <a href="https://lex.uz/ru/docs/-4517458">qaroriga</a> <br />ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-4518702" id="-4518702">Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan mobil qurilmalarni roʻyxatga olish tartibi toʻgʻrisida</div></div><div class="ACT_FORM"><div name="-4518705" id="-4518705">NIZOM</div></div><div class="BY_DEFAULT"><div name="-4518708" id="-4518708"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4518710" id="-4518710">1-bob. Umumiy qoidalar</div></div><div class="ACT_TEXT"><div name="-4518713" id="-4518713">1. Ushbu Nizom Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan mobil telefonlar hamda mobil aloqa moduliga ega qurilmalarni (keyin oʻrinlarda mobil qurilmalar deb ataladi) roʻyxatga olish tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-4518715" id="-4518715">2. Ushbu Nizomda quyidagi asosiy tushunchalardan foydalaniladi:</div></div><div class="BY_DEFAULT"><div name="-5205632" id="-5205632"></div></div><div class="ACT_TEXT"><div name="-5205634" id="-5205634"><strong>GSMA (Global System for Mobile Communication Association)</strong> — xalqaro mobil apparat identifikatorini yaratish uchun ishlatiladigan TAC kodini taqsimlash boʻyicha global boshqaruvchi. Uyushma TAC raqamlarining rasmiy intervallarini 3GPP mos keluvchi barcha qurilma ishlab chiqaruvchilariga tarqatadi va ushbu intervallarni va qurilma modeli maʼlumotlarini maʼlumotlar bazasiga yozib oladi. Ushbu maʼlumotlar bazasiga asoslanib qurilmani qidirish va identifikatsiya qilishga vakolatli tashkilotlarga IMEI orqali mobil qurilma ishlab chiqaruvchisi va modelini aniq identifikatsiyalash imkonini beradi; </div></div><div class="ACT_TEXT"><div name="-5205637" id="-5205637"><strong>IMEI (International Mobile Equipment Identifier)</strong> — har bir mobil qurilma uchun oʻziga xos boʻlgan 15 raqamdan iborat xalqaro mobil qurilmalar identifikatori (keyin oʻrinlarda — IMEI kodi). Asosiy identifikator GSMA tomonidan belgilangan maxsus TAC hisoblanadi. GSM/UMTS va boshqa mobil qurilmalarni identifikatsiyalash uchun qoʻllaniladi. Mobil qurilma bir yoki undan ortiq IMEI koddan iborat boʻlishi mumkin;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205653" id="-5205653">(2-bandning ikkinchi va uchinchi xatboshilari Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198384">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="ACT_TEXT"><div name="-4518727" id="-4518727"><strong>MSISDN (Mobile Station Integrated Services Digital Network)</strong> — GSM/UMTS standartlarida aloqa uchun xizmatlar integratsiyalashtirilgan raqamli tarmoq mobil abonentining raqami (masalan, +998 XX-XXX-XX-XX);</div></div><div class="ACT_TEXT"><div name="-4518729" id="-4518729"><strong>SIM-karta</strong> — ichiga mikrosxema oʻrnatilgan identifikatsiyalash moduli boʻlib, uning yordamida abonent qurilmasini identifikatsiyalash, mobil aloqa tarmogʻida undan foydalanish, shuningdek, GSM tarmogʻida abonent raqamidan ruxsatsiz foydalanishdan himoya qilish taʼminlanadi;</div></div><div class="ACT_TEXT"><div name="-4518733" id="-4518733"><strong>SMS (Short Message Service)</strong> — mobil qurilma yordamida qisqa matnli xabarlarni qabul qilish va uzatish imkonini beradigan texnologiya;</div></div><div class="ACT_TEXT"><div name="-4518736" id="-4518736"><strong>USSD (Unstructured Supplementary Service Data)</strong> — qisqa xabarlarni uzatish rejimida tarmoq abonenti va servis ilova oʻrtasida interaktiv oʻzaro hamkorlikni tashkil qilish imkonini beradigan GSM tarmoqlaridagi standart servis;</div></div><div class="ACT_TEXT"><div name="-4518739" id="-4518739"><strong>abonent</strong> — mobil aloqa operatori bilan mobil aloqa xizmatlarini koʻrsatish uchun shartnoma tuzgan jismoniy yoki yuridik shaxs;</div></div><div class="BY_DEFAULT"><div name="-5205664" id="-5205664"></div></div><div class="ACT_TEXT"><div name="-5205665" id="-5205665"><strong>import qiluvchi</strong> — mobil qurilmalarni Oʻzbekiston Respublikasi hududiga belgilangan tartibda tegishli bojxona rejimiga rasmiylashtirgan holda olib kiradigan jismoniy va yuridik shaxs; </div></div><div class="ACT_TEXT"><div name="-5205666" id="-5205666"><strong>IMEI-kodlar maʼlumotlar bazasi</strong> — tizimda roʻyxatdan oʻtgan va hisobga olingan barcha IMEI kodlari toʻplamidir. IMEI kodlarining maʼlumotlar bazasi oq, qora, kulrang va bogʻlangan-oq roʻyxatlardagi mobil qurilmalar IMEI-kodlaridan iborat;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205667" id="-5205667">(2-bandning toʻqqizinchi va oʻninchi xatboshilari Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198391">qarori</a> tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="ACT_TEXT"><div name="-4518746" id="-4518746"><strong>oq roʻyxat</strong> — mobil qurilmalar IMEI-kodlarining roʻyxati boʻlib, ular:</div></div><div class="ACT_TEXT"><div name="-4518747" id="-4518747">2019-yil 1-noyabrgacha boʻlgan davrda mobil aloqa operatorlarining tarmoqlariga ularni ulash (aktivlashtirish) orqali avtomatik rejimda roʻyxatga olingan;</div></div><div class="ACT_TEXT"><div name="-4518748" id="-4518748">ushbu Nizomga muvofiq roʻyxatga olingan boʻladi.</div></div><div class="ACT_TEXT"><div name="-4518750" id="-4518750">Oq roʻyxatga kiritilgan mobil qurilmalarga mobil aloqa xizmatlaridan mobil aloqa operatori bilan tuzilgan shartnomaga va amaldagi tarifga koʻra belgilangan tartibda foydalanishga ruxsat beriladi;</div></div><div class="BY_DEFAULT"><div name="-5205669" id="-5205669"></div></div><div class="ACT_TEXT"><div name="-5205670" id="-5205670"><strong>qora roʻyxat</strong> — tizimda roʻyxatdan oʻtmagan, klonlangan, IMEI kodi aniqlanmagan, GSMAning qora roʻyxatida boʻlgan mobil qurilmalar IMEI kodlari (roumingdagi mobil qurilmalarni ham oʻz ichiga oladi). </div></div><div class="ACT_TEXT"><div name="-5205671" id="-5205671">Qora roʻyxatga kiritilgan mobil qurilma IMEI-kodi mobil aloqa xizmatlaridan foydalanishi cheklanib (bir vaqtning oʻzida bogʻlangan oq roʻyxatda joylashgan mobil qurilmalarning IMEI-kodlari bundan mustasno), abonentga qora roʻyxatga kiritilganligi sababi haqida SMS ogohlantirish yuboriladi. </div></div><div class="ACT_TEXT"><div name="-5205672" id="-5205672">Mobil aloqa xizmatlaridan foydalanish cheklovi, mobil qurilma IMEI-kodi orqali qora roʻyxatga olingan holatda barcha telekommunikatsiya xizmatlaridan foydalanish imkoniyati mavjud emasligini anglatadi;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205673" id="-5205673">(2-bandning oʻn beshinchi — oʻn yettinchi xatboshilari Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli<a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198398"> qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-7834766" id="-7834766"></div></div><div class="ACT_TEXT"><div name="-7834767" id="-7834767"><strong>kul rang roʻyxat</strong> — oq yoki qora roʻyxatlarga kiritilmagan, ammo mobil aloqa operatorining tarmogʻida birinchi tarmoq hodisasi paytidan boshlab 30 kalendar kunidan koʻp boʻlmagan muddatga mobil aloqa xizmatlaridan foydalanish imkoniyatiga ega boʻladigan mobil qurilmalarning IMEI-kodlari roʻyxati (norezidentlarga tegishli mobil qurilmalar IMEI-kodlari ushbu roʻyxatda boʻlishi mumkin boʻlgan muddat bir kalendar yil davomida 60 kalendar kunini tashkil qiladi);</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-7834768" id="-7834768">(2-bandning oʻn sakkizinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2025-yil 6-noyabrdagi 700-sonli <a href="https://lex.uz/ru/docs/-7816457?ONDATE=08.02.2026 00#-7827149">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 07.11.2025-y., 09/25/700/1022-son. Kuchga kirish sanasi — 2026-yil 8-fevral)</div></div><div class="ACT_TEXT"><div name="-4518763" id="-4518763"><strong>bogʻlangan oq roʻyxat</strong> — mobil qurilmalar IMEI-kodlarining roʻyxati boʻlib, ular:</div></div><div class="ACT_TEXT"><div name="-4518768" id="-4518768">klonlangan yoki aniqlanmagan, ammo 2019-yilning 1-noyabrigacha boʻlgan davrda IMEI-kodni abonentning telefon raqami bilan bogʻlagan holda avtomatik ravishda roʻyxatga olingan boʻladi (IMEI — MSISDN);</div></div><div class="ACT_TEXT"><div name="-4518767" id="-4518767">GSMA talablariga javob beradigan, boshqa qurilma bilan birgalikda IMEI-kodlar maʼlumotlar bazasiga kiritilgan IMEI-kodli yangi mobil qurilma hisoblanadi va IMEI-kodning klonlanganligi aniqlanguniga qadar abonent tomonidan Tizim operatori yoki Tizim roʻyxatga oluvchisiga kelib, mobil qurilma hujjatlarini IMEI-kod hamda abonent telefon raqami bilan birgalikda (IMEI — MSISDN) taqdim etiladi.</div></div><div class="ACT_TEXT"><div name="-4518773" id="-4518773">Bogʻlangan oq roʻyxatdagi IMEI-kodli mobil qurilmalardan faqat abonentlarning bogʻlangan mobil raqamlari tomonidan foydalaniladi (IMEI — MSISDN);</div></div><div class="ACT_TEXT"><div name="-4518774" id="-4518774"><strong>mobil qurilma hujjatlari</strong> — texnik pasport, kafolat taloni, mobil qurilma qutisi yoki arizada koʻrsatilgan mobil qurilmaning IMEI-kodi roʻyxatga olinadigan mobil qurilma IMEI-kodiga mos kelishini isbotlash uchun asos boʻluvchi boshqa hujjat;</div></div><div class="ACT_TEXT"><div name="-4518776" id="-4518776"><strong>klonlangan IMEI-kod</strong> — GSMA tomonidan belgilangan boshqa mobil qurilma IMEI-kodining belgilari va ramzlarini toʻliq qaytaruvchi mobil qurilmaning IMEI-kodi;</div></div><div class="BY_DEFAULT"><div name="-6649290" id="-6649290"></div></div><div class="ACT_TEXT"><div name="-6649291" id="-6649291"><strong>mobil qurilmalar</strong> — mobil aloqa moduliga ega boʻlgan mobil telefonlar, qurilmalar va ularning ehtiyot qismlari (platalar); </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649296" id="-6649296">(2-bandning yigirma beshinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645758">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="ACT_TEXT"><div name="-4518783" id="-4518783"><strong>aniqlanmagan IMEI-kod</strong> — GSMA tomonidan belgilangan talablarga javob bermaydigan mobil qurilmaning IMEI-kodi;</div></div><div class="ACT_TEXT"><div name="-4518787" id="-4518787"><strong>mobil aloqa operatori</strong> — mobil aloqa tarmogʻiga ega boʻlgan, uning qurilishi, ishlashi, rivojlanishini taʼminlovchi va litsenziyaga asosan mobil aloqa xizmatlarini koʻrsatuvchi yuridik shaxs;</div></div><div class="ACT_TEXT"><div name="-4518791" id="-4518791"><strong>Tizim operatori</strong> — mobil qurilmalarning IMEI-kodlarini roʻyxatga oluvchi, Tizimning muntazam ishlashini va takomillashtirilishini taʼminlovchi yuridik shaxs;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649312" id="-6649312">(2-bandning yigirma toʻqqizinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645760">qaroriga </a>asosan 2024-yil 28-yanvardan chiqariladi — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son)</div></div><div class="ACT_TEXT"><div name="-4518799" id="-4518799"><strong>IMEI-kodlarni tekshirish</strong> — aniqlanmagan va klonlangan IMEI-kodlarni, shuningdek, yoʻqotilgan va oʻgʻirlangan mobil qurilmalarni aniqlash uchun mobil qurilmalarning IMEI-kodlarini Tizim bazasi bilan taqqoslash;</div></div><div class="ACT_TEXT"><div name="-4518803" id="-4518803"><strong>mobil qurilmalarni roʻyxatga olish</strong> — mobil qurilmalarning IMEI-kodlarini Tizim operatori IMEI-kodlarining maʼlumotlar bazasiga kiritish;</div></div><div class="ACT_TEXT"><div name="-4518804" id="-4518804"><strong>Tizim roʻyxatga oluvchisi</strong> — mobil qurilmalarning IMEI-kodlarini roʻyxatga olish uchun Tizim operatori bilan shartnoma tuzgan yakka tartibdagi tadbirkor yoki yuridik shaxs;</div></div><div class="BY_DEFAULT"><div name="-5205686" id="-5205686"></div></div><div class="ACT_TEXT"><div name="-5205689" id="-5205689"><strong>fuqaroligi boʻlmagan shaxslar</strong> — Oʻzbekiston Respublikasi hududida yashovchi, Oʻzbekiston Respublikasi fuqarosi boʻlmagan va xorijiy davlatning fuqaroligiga tegishli ekanligini isbotlamagan shaxslar; </div></div><div class="ACT_TEXT"><div name="-5205692" id="-5205692"><strong>chet davlat fuqarosi</strong> — Oʻzbekiston Respublikasining fuqaroligiga ega boʻlmagan, boshqa davlat fuqaroligiga va oʻzining boshqa davlat fuqaroligiga mansubligiga doir dalilga ega boʻlgan shaxs;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205697" id="-5205697">(2-bandning oʻttiz uchinchi va oʻttiz toʻrtinchi xatboshilari Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198404">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="ACT_TEXT"><div name="-4518810" id="-4518810"><strong>rouming </strong>— bir mobil aloqa operatorining abonenti boshqa mobil aloqa operatorining xizmat koʻrsatish hududida bir davlat doirasida (milliy rouming) yoki boshqa mamlakatda (xalqaro rouming) boʻlganda uning boshqa mobil aloqa operatorining tarmogʻidan foydalanishini taʼminlovchi xizmat;</div></div><div class="ACT_TEXT"><div name="-4518812" id="-4518812"><strong>mobil qurilmalarni xalqaro oʻziga xos identifikatsiya kodlari boʻyicha roʻyxatga olish tizimi</strong> (keyingi oʻrinlarda Tizim deb ataladi) — ushbu Nizomda nazarda tutilgan mobil qurilmalarni texnik identifikatsiyalash parametrlari toʻgʻrisidagi maʼlumotlarni roʻyxatga olish, yigʻish, saqlash va qayta ishlash uchun foydalaniladigan axborot tizimi;</div></div><div class="ACT_TEXT"><div name="-4518814" id="-4518814"><strong>tarmoq hodisasi</strong> — mobil qurilmani mobil aloqa operatorining tarmogʻiga uning abonent SIM-kartasidan foydalanish orqali ulash;</div></div><div class="BY_DEFAULT"><div name="-5205701" id="-5205701"></div></div><div class="ACT_TEXT"><div name="-5205703" id="-5205703"><strong>TAC (Type Allocation Code)</strong> — simsiz qurilmalarni oʻziga xos identifikatsiyalash uchun ishlatiladigan IMEI identifikatorining dastlabki sakkiz xonali qismidir. TAC IMEIdan foydalangan holda GSM, UMTS yoki boshqa simsiz qurilmalarni aniq modelini identifikatsiyalaydi; </div></div><div class="ACT_TEXT"><div name="-5205708" id="-5205708"><strong>yashash guvohnomasi</strong> — fuqaroligi boʻlmagan shaxsning yoki chet davlat fuqarosining shaxsini tasdiqlaydigan, Oʻzbekiston Respublikasi hududida doimiy yashashga ruxsat etilganligining tasdigʻi sifatida berilgan hujjat.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205729" id="-5205729">(2-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli qaroriga asosan <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198410">xatboshilar </a>bilan toʻldirilgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4518817" id="-4518817">2-bob. Tizimning vazifasi va imkoniyatlari</div></div><div class="ACT_TEXT"><div name="-4518821" id="-4518821">3. Tizim ushbu Nizomning talablariga koʻra mobil qurilmalarni roʻyxatga olish, Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan barcha mobil qurilmalarning IMEI-kodlari toʻgʻrisidagi axborotni oʻz ichiga olgan yagona maʼlumotlar bazasini yaratish, shuningdek, mobil qurilmalar IMEI-kodlarining oq, kul rang, qora, bogʻlangan oq roʻyxatlarini shakllantirish va taʼminlash uchun moʻljallangan.</div></div><div class="ACT_TEXT"><div name="-4518823" id="-4518823">4. IMEI-kodlarni tekshirish va mobil qurilmalarni roʻyxatga olish bilan bogʻliq barcha jarayonlar Tizim yordamida amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4518824" id="-4518824">5. Import qiluvchilar va jismoniy shaxslar Oʻzbekiston Respublikasi hududida qurilmani xarid qilishdan avval IMEI-kodning maqomini tekshirish va aniqlanmagan, klonlangan, yoʻqotilgan va oʻgʻirlangan mobil qurilmalarni aniqlash uchun IMEI-kodlarning maʼlumotlar bazasiga SMS/USSD soʻrov yuborishlari yoki www.uzimei.uz manzil boʻyicha Tizim operatorining saytiga murojaat qilishlari mumkin.</div></div><div class="BY_DEFAULT"><div name="-5205829" id="-5205829"></div></div><div class="ACT_TEXT"><div name="-5205833" id="-5205833">Tizim operatoridan barcha SMS-xabarlar va abonentlardan mobil qurilmaning IMEI-kodini roʻyxatdan oʻtkazish va tekshirish tartibi bilan bogʻliq SMS/USSD soʻrovlari mobil operatorlar tarmoqlari orqali bepul amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205836" id="-5205836">(5-bandning ikkinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198419">qarori</a> tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4518835" id="-4518835">3-bob. Mobil qurilmalarni roʻyxatga olish tartibi va shartlari</div></div><div class="BY_DEFAULT"><div name="-5205837" id="-5205837"></div></div><div class="ACT_TEXT"><div name="-5205838" id="-5205838">6. Oʻzbekiston Respublikasi hududiga olib kirilgan, Oʻzbekiston Respublikasi hududida ishlab chiqarilayotgan va foydalanilayotgan mobil qurilmalarni roʻyxatdan oʻtkazish majburiydir. Oʻzbekiston Respublikasi hududida roumingda boʻlib, mahalliy operator tarmogʻida ilgari tarmoq hodisasi qayd etilmagan mobil qurilmalar bundan mustasno.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205839" id="-5205839">(6-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198423">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-5205842" id="-5205842"></div></div><div class="ACT_TEXT"><div name="-5205843" id="-5205843">6<sup>1</sup>. Oʻzbekiston Respublikasi hududida mobil qurilmalar chakana savdosi bilan shugʻullanuvchi tadbirkorlik subyektlari mobil qurilmalarni respublika hududiga olib kirish sanasidan qatʼiy nazar, ularni roʻyxatdan oʻtkazish uchun javobgar boʻladilar</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205848" id="-5205848">(6<sup>1</sup>-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198425">qaroriga </a>asosan kiritilgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="ACT_TEXT"><div name="-4518839" id="-4518839">7. Klonlangan va aniqlanmagan IMEI-kodli mobil qurilmalar Tizimda roʻyxatga olinmaydi.</div></div><div class="ACT_TEXT"><div name="-4518841" id="-4518841">8. Mobil qurilmalarni xalqaro oʻziga xos identifikatsiya kodlari boʻyicha roʻyxatga olish tizimida roʻyxatga olinishi kerak boʻlgan mobil qurilmalar turlarining roʻyxati ushbu Nizomga <a href="https://lex.uz/ru/docs/-4517458#-4519102">1-ilovada </a>beriladi.</div></div><div class="BY_DEFAULT"><div name="-5205854" id="-5205854"></div></div><div class="ACT_TEXT"><div name="-5205856" id="-5205856">Mobil qurilmalarni roʻyxatga olish ushbu Nizomning <a href="https://lex.uz/ru/docs/-4517458#-4518855">4</a> va <a href="https://lex.uz/ru/docs/-4517458#-4518916">5-boblarida </a>koʻrsatilgan talablarga muvofiq jismoniy va yuridik shaxslarning Tizim operatori yoki Tizim roʻyxatga oluvchisiga qilgan murojaatlari boʻyicha amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205858" id="-5205858">(8-bandning ikkinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198427">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="ACT_TEXT"><div name="-4518850" id="-4518850">9. Avval roʻyxatga olingan mobil qurilmalar qayta roʻyxatga olinmaydi.</div></div><div class="ACT_TEXT"><div name="-4518852" id="-4518852">10. Davlat tomonidan qoʻriqlanishi kerak boʻlgan shaxslarning xavfsizligi, mamlakatda mudofaa qobiliyati, xavfsizlik va ichki tartibni taʼminlash va favqulodda vaziyatlar holatida ehtiyojlarni taʼminlash uchun Oʻzbekiston Respublikasi hududiga olib kirilgan mobil qurilmalarning IMEI-kodlarini roʻyxatga olish vakolatli organlarning tegishli murojaatlari boʻyicha alohida tartibda amalga oshiriladi.</div></div><div class="BY_DEFAULT"><div name="-5205862" id="-5205862"></div></div><div class="BY_DEFAULT"><div name="-5205863" id="-5205863"></div></div><div class="BY_DEFAULT"><div name="-8027600" id="-8027600"></div></div><div class="ACT_TEXT"><div name="-8027601" id="-8027601">10<sup>1</sup>. Xorijiy davlatlarning Oʻzbekiston Respublikasida akkreditatsiyadan oʻtgan diplomatik vakolatxonalari, konsullik muassasalari va ularga tenglashtirilgan tashkilotlar (keyingi oʻrinlarda — diplomatik vakolatxonalar) mobil qurilmalari IMEI-kodlarini roʻyxatdan oʻtkazish uchun Oʻzbekiston Respublikasi Tashqi ishlar vazirligi huzuridagi “Diplomatik servis xizmati” davlat muassasasiga mazkur Nizomning <a href="https://lex.uz/ru/docs/-4517458#-5206179">3a-ilovasiga </a>muvofiq toʻldirilgan arizani ilova qilgan holda murojaat qiladi. Bunda diplomatik vakolatxonalar tomonidan mobil qurilmalar diplomatik pochta orqali olinmagan taqdirda arizaga bojxona yuk deklaratsiyasi (keyingi oʻrinlarda — BYD) yoki bojxona kirim orderi taqdim etiladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-8027602" id="-8027602">(10<sup>1</sup>-bandning birinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2026-yil 23-yanvardagi 26-sonli <a href="https://lex.uz/ru/docs/-8014108?ONDATE=26.01.2026 00#-8020247">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 26.01.2026-y., 09/26/26/0076-son)</div></div><div class="BY_DEFAULT"><div name="-8027603" id="-8027603"></div></div><div class="ACT_TEXT"><div name="-8027604" id="-8027604">Tizim operatori “Diplomatik servis xizmati” davlat muassasasi bergan arizaga muvofiq IMEI-kodlarini roʻyxatdan oʻtkazishni ariza olingan kundan boshlab 3 ish kuni mobaynida toʻlov asosida amalga oshiradi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-8027605" id="-8027605">(10<sup>1</sup>-bandning ikkinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2026-yil 23-yanvardagi 26-sonli <a href="https://lex.uz/ru/docs/-8014108?ONDATE=26.01.2026 00#-8020247">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 26.01.2026-y., 09/26/26/0076-son)</div></div><div class="ACT_TEXT"><div name="-5205865" id="-5205865">10<sup>2</sup>. Sud qaroriga koʻra davlat egaligiga oʻtkazilgan mobil qurilmalar IMEI-kodlarini roʻyxatdan oʻtkazish uchun davlat ijrochisi tomonidan mazkur Nizomning <a href="https://lex.uz/ru/docs/-4517458#-5206192">3b-ilovasiga </a>muvofiq toʻldirilgan anketa va sud qarorining nusxasini tizim operatoriga taqdim etadi. </div></div><div class="ACT_TEXT"><div name="-5205867" id="-5205867">Tizim operatori davlat ijrochisi tomonidan taqdim etilgan maʼlumotlar asosida mobil qurilmalar IMEI-kodlarini ariza kelib tushgan kundan boshlab 3 ish kuni mobaynida roʻyxatdan oʻtkazadi. </div></div><div class="ACT_TEXT"><div name="-5205868" id="-5205868">Tizim operatori bilan Oʻzbekiston Respublikasi Bosh prokuraturasi huzuridagi Majburiy ijro byurosi oʻrtasida sud qaroriga koʻra davlat egaligiga oʻtkazilgan mobil qurilmalar boʻyicha elektron axborot almashinuvi amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205871" id="-5205871">(10<sup>1</sup> va 10<sup>2</sup>-bandlar Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198428">qaroriga </a>asosan kiritilgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4518855" id="-4518855">4-bob. Import qiluvchi va ishlab chiqaruvchi tashkilot tomonidan mobil qurilmalarni roʻyxatga olish</div></div><div class="ACT_TEXT"><div name="-4518858" id="-4518858">11. Oʻzbekiston Respublikasi hududiga/hududida import qiluvchilar tomonidan olib kiriladigan va ishlab chiqaruvchi tashkilotlar tomonidan ishlab chiqariladigan mobil qurilmalarni roʻyxatga olish ushbu Nizomga <a href="https://lex.uz/ru/docs/-4517458#-4519119">2-ilovadagi </a>sxema boʻyicha amalga oshiriladi.</div></div><div class="BY_DEFAULT"><div name="-6649321" id="-6649321"></div></div><div class="ACT_TEXT"><div name="-6649322" id="-6649322">Import qiluvchilar tomonidan olib kirilayotgan mobil qurilmalarning Tizimda roʻyxatga olinishi “erkin muomalaga chiqarish” (IM-40) bojxona rejimiga rasmiylashtirilganidan soʻng uch kun muddatda amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649325" id="-6649325">(11-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645762">qaroriga </a>asosan xatboshi bilan toʻldirilgan — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="ACT_TEXT"><div name="-4518860" id="-4518860">12. Eksport qilish uchun ishlab chiqarilgan mobil qurilmalarning IMEI-kodlari roʻyxatga olinmaydi. </div></div><div class="ACT_TEXT"><div name="-4518863" id="-4518863">13. Import qiluvchilar va ishlab chiqaruvchi tashkilotlar (keyingi oʻrinlarda ariza beruvchi deb ataladi) mobil qurilmalarni roʻyxatga olishni:</div></div><div class="ACT_TEXT"><div name="-4518865" id="-4518865">Tizim operatoriga oʻzi kelib murojaat etish orqali;</div></div><div class="ACT_TEXT"><div name="-4518867" id="-4518867">Oʻzbekiston Respublikasi Yagona interaktiv davlat xizmatlari portali (keyingi oʻrinlarda YIDXP deb ataladi) orqali amalga oshirishlari mumkin.</div></div><div class="BY_DEFAULT"><div name="-5205889" id="-5205889"></div></div><div class="ACT_TEXT"><div name="-5205890" id="-5205890">14. Mobil qurilmalarni roʻyxatga olish uchun ariza beruvchi Oʻzbekiston Respublikasi hududiga/hududida olib kirilgan/ishlab chiqarilgan mobil qurilmalarning tegishli ravishda ariza beruvchining turiga qarab, ushbu Nizomga <a href="https://lex.uz/ru/docs/-4517458#-5206202">3v</a> yoki <a href="https://lex.uz/ru/docs/-4517458#-5206209">3g-ilovalardagi </a>shaklga muvofiq toʻldirilgan anketani taqdim etadi. </div></div><div class="ACT_TEXT"><div name="-5205891" id="-5205891">Import qiluvchilar anketada olib kirilgan qurilmalar partiyasi uchun “erkin muomalaga chiqarish” (IM-40) bojxona rejimiga rasmiylashtirilgan BYDning roʻyxatga olingan bojxona posti, sanasi va raqamini koʻrsatadi. Agar import qiluvchi tomonidan anketada koʻrsatilgan axborot BYD yoki bojxona kirim orderida aks ettirilgan axborotga mos kelmasa, qurilmalarning butun tovar partiyasi roʻyxatga olinmaydi. </div></div><div class="ACT_TEXT"><div name="-5205892" id="-5205892">Bunda, chetdan keltiriladigan mobil qurilmalarning IMEI-kodlari toʻgʻrisidagi elektron maʼlumot import qiluvchilar tomonidan majburiy tartibda BYDning 31-ustunida koʻrsatilgan boʻlishi lozim. </div></div><div class="ACT_TEXT"><div name="-5205893" id="-5205893">Mobil qurilmalar IMEI-kodlarini roʻyxatdan oʻtkazish uchun ishlab chiqaruvchi tashkilotlar qurilma ishlab chiqarish uchun tegishli ruxsatnomalarni, shuningdek, vakolatli organning mahalliy ishlab chiqaruvchisi haqidagi maʼlumotlarni (GSMA assotsiatsiyasining TAC sertifikatlari va boshqa ruxsatnomalar) taqdim etishi kerak. </div></div><div class="ACT_TEXT"><div name="-5205894" id="-5205894">Bunda mobil qurilmalarning markasi, modeli, soni toʻgʻrisidagi maʼlumotlar va ular IMEI-kodlarining roʻyxati ariza beruvchilar tomonidan elektron koʻrinishda taqdim etiladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205895" id="-5205895">(14-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198436">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-6649327" id="-6649327"></div></div><div class="ACT_TEXT"><div name="-6649328" id="-6649328">Import qiluvchilar tomonidan olib kirilgan qurilmalar partiyasi “erkin muomalaga chiqarish” (IM-40) bojxona rejimiga rasmiylashtirilmaguncha, mazkur qurilmalarning IMEI kodlari Tizimda roʻyxatdan oʻtkazilishiga yoʻl qoʻyilmaydi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649332" id="-6649332">(14-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645764">qaroriga </a>asosan xatboshi bilan toʻldirilgan — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="BY_DEFAULT"><div name="-7834776" id="-7834776"></div></div><div class="ACT_TEXT"><div name="-7834777" id="-7834777">Ariza beruvchi va jismoniy shaxslar mazkur bandda keltirilgan roʻyxatga olinmaydigan hamda roʻyxatdan oʻtkazishga yoʻl qoʻyilmaydigan holatlarni va hujjatlardagi maʼlumotlar oʻrtasidagi nomuvofiqliklarni bartaraf etilgandan soʻng oʻn kun muddatda mobil qurilmalarni roʻyxatga olish boʻyicha qayta murojaat qilishlari mumkin.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-7834779" id="-7834779">(14-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2025-yil 6-noyabrdagi 700-sonli <a href="https://lex.uz/ru/docs/-7816457?ONDATE=08.02.2026 00#-7827150">qaroriga </a>asosan  yettinchi xatboshi bilan toʻldirilgan — Qonunchilik maʼlumotlari milliy bazasi, 07.11.2025-y., 09/25/700/1022-son. Kuchga kirish sanasi — 2026-yil 8-fevral)</div></div><div class="ACT_TEXT"><div name="-4518879" id="-4518879">15. Roʻyxatga olish uchun oʻzi kelib murojaat qilish tartibida toʻldirilgan anketa Tizim operatori yoki Tizim roʻyxatga oluvchisining masʼul shaxsi tomonidan qabul qilinadi.</div></div><div class="ACT_TEXT"><div name="-4518881" id="-4518881">Masʼul shaxs tomonidan YIDXP orqali elektron shaklda taqdim etilgan mobil qurilmani roʻyxatga olish toʻgʻrisidagi anketa uning olinganligi toʻgʻrisidagi bildirishnoma bilan qabul qilinadi, shuningdek, roʻyxat raqami berilgan holda avtomatik ravishda YIDXPda roʻyxatga olinadi.</div></div><div class="ACT_TEXT"><div name="-4518886" id="-4518886">16. Roʻyxatga olish uchun ariza beruvchi tomonidan taqdim etiladigan mobil qurilmalarning soni cheklanmagan.</div></div><div class="ACT_TEXT"><div name="-4518887" id="-4518887">17. Ariza beruvchidan ushbu Nizomning <a href="https://lex.uz/ru/docs/-4517458#-4518871">14-bandida </a>nazarda tutilmagan hujjatlar va maʼlumotlarning taqdim etishni talab qilishga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-4518897" id="-4518897">18. Mobil qurilmalarni roʻyxatga olish uchun ushbu Nizomning <a href="https://lex.uz/ru/docs/-4517458#-4518871">14-bandida </a>nazarda tutilmagan qoʻshimcha maʼlumotlarni olish zarur boʻlganda, Tizim operatori Oʻzbekiston Respublikasi Vazirlar Mahkamasining “Tadbirkorlik subyektlariga davlat xizmatlari koʻrsatish tartibini yanada takomillashtirish chora-tadbirlari toʻgʻrisida” 2014-yil 31-dekabrdagi 377-son <a href="https://lex.uz/ru/docs/-2534723">qarori</a> bilan belgilangan tartibda boshqa vakolatli organlardan mustaqil ravishda ularni soʻraydi va oladi.</div></div><div class="ACT_TEXT"><div name="-4518899" id="-4518899">Mobil qurilmalarni roʻyxatga olish uchun zarur boʻlgan hujjatlar va axborotga ega boʻlgan davlat organlari tegishli idoralararo soʻrovni olgan paytdan boshlab bir ish kuni ichida bunday hujjatlar va axborotni (arxiv maʼlumotlaridan tashqari) taqdim etishga majbur. </div></div><div class="BY_DEFAULT"><div name="-5988301" id="-5988301"></div></div><div class="ACT_TEXT"><div name="-5988310" id="-5988310">19. Ishonchli boʻlmagan yoki notoʻgʻri maʼlumotlar berganligi uchun ariza beruvchi qonunchilikka muvofiq javobgar boʻladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5988320" id="-5988320">(19-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2022-yil 4-apreldagi 153-sonli <a href="https://lex.uz/ru/docs/-5936929?ONDATE=05.04.2022 00#-5939974">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 05.04.2022-y., 09/22/153/0266-son)</div></div><div class="ACT_TEXT"><div name="-4518905" id="-4518905">20. Ariza beruvchining anketasini koʻrib chiqish va mobil qurilmalarning IMEI-kodlarini roʻyxatga olish 3 (uch) ish kuni ichida amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4518906" id="-4518906">21. Roʻyxatga olish jarayoni tugaganidan keyin Tizim operatori yoki Tizim roʻyxatga oluvchisi 1 ish kuni ichida belgilangan tartibda ariza beruvchiga toʻlash uchun hisobni taqdim etadi.</div></div><div class="BY_DEFAULT"><div name="-6649385" id="-6649385"></div></div><div class="ACT_TEXT"><div name="-6649388" id="-6649388">22. Ariza beruvchi tomonidan toʻlov 10 ish kuni ichida amalga oshirilgandan keyin Tizim operatori yoki Tizim roʻyxatga oluvchisi 1 ish kuni ichida barcha IMEI-kodlarni oq roʻyxatga kiritadi va agar mavjud boʻlsa, roʻyxatga olib boʻlmaydigan mobil qurilmalarning IMEI-kodlari roʻyxatini koʻrsatgan holda, ariza beruvchini anketada koʻrsatilgan usul orqali roʻyxatga olish tugaganligi toʻgʻrisida xabardor qiladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649389" id="-6649389">(22-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645766">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4518916" id="-4518916">5-bob. Jismoniy shaxslar tomonidan mobil qurilmalarni roʻyxatga olish</div></div><div class="ACT_TEXT"><div name="-4518919" id="-4518919">23. Abonentlar tomonidan foydalaniladigan va 2019-yilning 1-noyabrigacha tarmoqda aktiv (ulangan) holatda boʻlgan barcha mobil qurilmalar roʻyxatga olinadi va Tizim operatori IMEI-kodlarining maʼlumotlar bazasiga avtomatik ravishda kiritiladi (ular egalarining hech qanday qoʻshimcha arizalari talab etilmaydi).</div></div><div class="BY_DEFAULT"><div name="-5205897" id="-5205897"></div></div><div class="ACT_TEXT"><div name="-5205898" id="-5205898">Agar mobil qurilmaning bir slotiga tegishli IMEI-kodi 2019-yil 1-noyabrgacha avtomatik roʻyxatdan oʻtgan va bazaga kiritilgan boʻlsa, uning boshqa slotidagi IMEI-kodi qurilma egasi tomonidan quyidagi harakatlar bajarilganidan soʻng Tizim operatori tomonidan 3 ish soati mobaynida bepul ravishda amalga oshiriladi: </div></div><div class="ACT_TEXT"><div name="-5205899" id="-5205899">mobil qurilma egasining Tizim operatori yoki Tizim roʻyxatga oluvchisiga shaxsni tasdiqlovchi hujjat bilan shaxsan murojaat qilishi; </div></div><div class="ACT_TEXT"><div name="-5205900" id="-5205900">ushbu IMEI kodining ushbu mobil qurilmaga haqiqiy ekanligini tasdiqlash (mobil qurilma klaviaturasida *#06# kodini yozib olingan IMEI kodining ekran tasvirini taqdim etish); </div></div><div class="ACT_TEXT"><div name="-5205901" id="-5205901">ushbu Nizomning <a href="https://lex.uz/ru/docs/-4517458#-5206248">5a-ilovasiga </a>muvofiq toʻldirilgan anketani taqdim etishi. </div></div><div class="ACT_TEXT"><div name="-5205902" id="-5205902">Agar mobil qurilmaning bir slotiga tegishli IMEI-kodi 2019-yil 1-noyabrdan keyin arizaga asosan roʻyxatga olingan boʻlsa, ushbu qurilmaning boshqa sloti IMEI kodini roʻyxatdan oʻtkazish quyidagi harakatlar amalga oshirilganida 3 soat ish vaqtida toʻlov asosida amalga oshiriladi: </div></div><div class="ACT_TEXT"><div name="-5205903" id="-5205903">mobil qurilma egasining Tizim operatori yoki Tizim roʻyxatga oluvchisiga shaxsan murojaat qilgan holda shaxsni tasdiqlovchi hujjatni taqdim qilishi; </div></div><div class="ACT_TEXT"><div name="-5205904" id="-5205904">ushbu IMEI kodining ushbu mobil qurilmaga haqiqiy ekanligini tasdiqlash (mobil qurilma klaviaturasida *#06# kodini yozib olingan IMEI kodining ekran tasvirini taqdim etish); </div></div><div class="ACT_TEXT"><div name="-5205905" id="-5205905">IMEI-kodini roʻyxatdan oʻtkazish uchun anketa ushbu Nizomning <a href="https://lex.uz/ru/docs/-4517458#-5206248">5a-ilovasiga </a>muvofiq, 2019-yil 1-noyabrdan soʻng roʻyxatdan oʻtkazilgan mobil qurilmalarning markasi, modeli, soni va IMEI-kodlari koʻrsatilgan holda toʻldiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205906" id="-5205906">(23-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198454">qaroriga </a>asosan ikkinchi — toʻqqizinchi xatboshilar bilan toʻldirilgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="ACT_TEXT"><div name="-4518920" id="-4518920">24. Jismoniy shaxslar tomonidan Tizim operatorining bazasida import qiluvchilar yoki ishlab chiqaruvchi tashkilotlar tomonidan avval roʻyxatga olingan Oʻzbekiston Respublikasi hududida sotib olingan mobil qurilmalarni roʻyxatga olish talab etilmaydi.</div></div><div class="ACT_TEXT"><div name="-4518921" id="-4518921">25. Jismoniy shaxs tomonidan Oʻzbekiston Respublikasi hududiga olib kirilgan mobil qurilmalarni roʻyxatga olish ushbu Nizomga <a href="https://lex.uz/ru/docs/-4517458#-4519216">4-ilovadagi </a>sxemaga muvofiq amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4518923" id="-4518923">26. Jismoniy shaxslar tomonidan, shu jumladan xalqaro pochta yoki kuryerlik joʻnatmalari orqali olib kirilgan mobil qurilmalar dastlabki muvaffaqiyatli tarmoq hodisasi kunidan boshlab 30 kalendar kuni davomida roʻyxatga olinadi.</div></div><div class="BY_DEFAULT"><div name="-4518926" id="-4518926"></div></div><div class="BY_DEFAULT"><div name="-5205908" id="-5205908"></div></div><div class="ACT_TEXT"><div name="-5205909" id="-5205909">27. Tizim operatori mobil qurilmasi dastlabki muvaffaqiyatli tarmoq hodisasidan oʻtgan abonentni 30 kalendar kuni davomida ushbu mobil qurilmani roʻyxatga olish zarurligi va koʻrsatilgan muddat tugaganidan keyin roʻyxatga olinmaganda, uning mobil aloqa xizmatlaridan foydalanishi cheklanishi toʻgʻrisida xabardor qilish choralarini koʻradi. </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205910" id="-5205910">(27-bandning birinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198484">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-5205911" id="-5205911"></div></div><div class="ACT_TEXT"><div name="-5205912" id="-5205912">Xabar dastlabki muvaffaqiyatli tarmoq hodisasi paytida va 30 kun muddat tugashidan besh kun oldin davlat, rus va ingliz tillarida mobil aloqa operatorlari tarmoqlari orqali Tizim operatori tomonidan SMS-xabar joʻnatish orqali beriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205913" id="-5205913">(27-bandning ikkinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198486">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-6649390" id="-6649390"></div></div><div class="ACT_TEXT"><div name="-6649391" id="-6649391">28. Oʻzbekiston Respublikasi fuqarosi tomonidan mobil qurilmalar IMEI-kodlarini roʻyxatga olish: </div></div><div class="ACT_TEXT"><div name="-6649392" id="-6649392">Tizim operatori yoki Tizim roʻyxatga oluvchisiga shaxsan kelib murojaat qilish yoʻli bilan, Oʻzbekiston Respublikasi fuqarosi uchun JSHSHIR mavjud shaxsni tasdiqlovchi hujjat va ushbu Nizomning 5b-ilovasiga muvofiq Oʻzbekiston Respublikasiga olib kirilgan mobil qurilmaning IMEI-kodlari, soni, modeli va markasi koʻrsatilgan anketani toʻldirgan holda; </div></div><div class="ACT_TEXT"><div name="-6649393" id="-6649393">YIDXP orqali — jismoniy shaxsning elektron raqamli imzosi yoki Mobil-ID tizimi yordamida; </div></div><div class="ACT_TEXT"><div name="-6649394" id="-6649394">Tizim operatorining veb-sayti orqali — roʻyxatdan oʻtkazilayotgan mobil qurilmaning IMEI-kodi, JSHSHIR va abonent raqamini kiritish orqali; </div></div><div class="ACT_TEXT"><div name="-6649396" id="-6649396">Tizim operatorining veb-sayti va mobil ilovalar orqali — shaxsning biometrik maʼlumotlarini identifikatsiya qilish va mobil qurilma IMEI kodlarini kiritish bilan amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649397" id="-6649397">(28-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645767">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="BY_DEFAULT"><div name="-5205925" id="-5205925"></div></div><div class="ACT_TEXT"><div name="-5205926" id="-5205926">28<sup>1</sup>. Chet davlat fuqarosi, Oʻzbekiston Respublikasida yashash guvohnomasiga ega chet davlat fuqarosi, Oʻzbekiston Respublikasida yashash guvohnomasiga ega fuqaroligi boʻlmagan shaxs tomonidan mobil qurilmalar IMEI-kodlarini roʻyxatga olish: </div></div><div class="ACT_TEXT"><div name="-5205927" id="-5205927">Tizim operatori yoki Tizim roʻyxatga oluvchisiga shaxsan murojaat qilish yoʻli bilan ushbu Nizomning 5b-ilovasiga muvofiq Oʻzbekiston Respublikasiga olib kirilgan mobil qurilmaning IMEI-kodlari, soni, modeli va markasi koʻrsatilgan anketani toʻldirish va quyidagilarni taqdim etgan holda: </div></div><div class="ACT_TEXT"><div name="-5205928" id="-5205928">chet davlat fuqarosi uchun Oʻzbekiston Respublikasiga kirib kelishi qayd etilgan shaxsni tasdiqlovchi hujjati; </div></div><div class="ACT_TEXT"><div name="-5205935" id="-5205935">Oʻzbekiston Respublikasida yashash guvohnomasiga ega chet davlat fuqarosi uchun Oʻzbekiston Respublikasiga kirib kelishi qayd etilgan shaxsni tasdiqlovchi hujjati hamda yashash uchun guvohnomasi; </div></div><div class="ACT_TEXT"><div name="-5205938" id="-5205938">Oʻzbekiston Respublikasida yashash guvohnomasiga ega fuqaroligi boʻlmagan shaxs uchun biometrik harakatlanish hujjatining nusxasi hamda yashash uchun guvohnomasini taqdim qilish orqali;</div></div><div class="BY_DEFAULT"><div name="-6226900" id="-6226900"></div></div><div class="ACT_TEXT"><div name="-6226901" id="-6226901">YIDXP orqali — jismoniy shaxsning elektron raqamli imzosi yoki Mobil-ID tizimi yordamida; </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6226902" id="-6226902">(28<sup>1</sup>-bandning oltinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2022-yil 28-sentabrdagi 541-sonli <a href="https://lex.uz/ru/docs/-6212405?ONDATE=29.09.2022 01#-6216237">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 29.09.2022-y., 09/22/541/0859-son)</div></div><div class="ACT_TEXT"><div name="-5205941" id="-5205941">Tizim operatorining veb sayti orqali — roʻyxatdan oʻtkazilayotgan mobil qurilmaning IMEI-kodi, shaxsiy abonent raqami va quyidagilarni taqdim etgan holda: </div></div><div class="BY_DEFAULT"><div name="-6649400" id="-6649400"></div></div><div class="ACT_TEXT"><div name="-6649401" id="-6649401">mobil ilovalar orqali — shaxsning biometrik maʼlumotlarini identifikatsiya qilish va mobil qurilma IMEI kodlarini kiritish bilan amalga oshiriladi; </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649402" id="-6649402">(28<sup>1</sup>-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645774">qaroriga </a>asosan sakkizinchi xatboshi bilan toʻldirilgan — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="ACT_TEXT"><div name="-5205942" id="-5205942">chet davlat fuqarosi uchun Oʻzbekiston Respublikasiga kirib kelishi qayd etilgan shaxsni tasdiqlovchi hujjat raqami; </div></div><div class="ACT_TEXT"><div name="-5205943" id="-5205943">Oʻzbekiston Respublikasida yashash guvohnomasiga ega chet davlat fuqarosi uchun Oʻzbekiston Respublikasiga kirib kelishi qayd etilgan shaxsni tasdiqlovchi hujjatining hamda yashash uchun guvohnomasining raqamlari; </div></div><div class="ACT_TEXT"><div name="-5205944" id="-5205944">Oʻzbekiston Respublikasida yashash guvohnomasiga ega fuqaroligi boʻlmagan shaxs uchun yashash uchun guvohnomasining hamda biometrik harakatlanish hujjatining raqamlari hamda JSHSHIR kiritish bilan amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205946" id="-5205946">(28<sup>1</sup>-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198519">qaroriga </a>asosan kiritilgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-6649404" id="-6649404"></div></div><div class="ACT_TEXT"><div name="-6649405" id="-6649405">29. Mobil qurilmalarni roʻyxatga olish uchun jismoniy shaxs quyidagilarni taqdim etadi: </div></div><div class="ACT_TEXT"><div name="-6649406" id="-6649406">ushbu Nizomga <a href="https://lex.uz/ru/docs/-4517458#-5206241">5-ilovaga </a>muvofiq shakl boʻyicha toʻldirilgan Anketani, shu jumladan Oʻzbekiston Respublikasi hududiga olib kirilgan mobil qurilmalarning markasi, modeli, soni va IMEI-kodlari; </div></div><div class="ACT_TEXT"><div name="-6649407" id="-6649407">oʻzi kelib murojaat etganda — Tizim operatori yoki Tizim roʻyxatga oluvchisi uchun JSHSHIR mavjud shaxsni tasdiqlovchi hujjat; </div></div><div class="ACT_TEXT"><div name="-6649408" id="-6649408">anketa YIDXP orqali elektron shaklda taqdim etilganda jismoniy shaxsdan fuqarolik pasporti va elektron raqamli imzosi talab etilmaydi; </div></div><div class="ACT_TEXT"><div name="-6649409" id="-6649409">Tizim operatorining saytida — abonent roʻyxatdan oʻtkaziladigan mobil qurilmaning IMEI-kodi, ariza beruvchining JSHSHIR va telefon raqamini koʻrsatadi. </div></div><div class="ACT_TEXT"><div name="-6649410" id="-6649410">Veb-sayt va mobil ilovalar orqali shaxsning biometrik maʼlumotlarini identifikatsiya qilish va mobil qurilma IMEI-kodlarini kiritish bilan amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649414" id="-6649414">(29-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645777">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="BY_DEFAULT"><div name="-6649424" id="-6649424"></div></div><div class="ACT_TEXT"><div name="-6649426" id="-6649426">29<sup>1</sup>. Jismoniy shaxslar tomonidan mobil qurilmalarni olib kirishda bojxona toʻlovlari undirilmaydigan cheklangan meʼyorlaridan qatʼi nazar, deklaratsiya toʻldiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649433" id="-6649433">(29<sup>1</sup>-band Oʻzbekiston Respublikasi Vazirlar 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645784">qaroriga </a>asosan kiritilgan — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi) </div></div><div class="ACT_TEXT"><div name="-4519010" id="-4519010">30. Roʻyxatga olish uchun oʻzi kelib murojaat etish tartibida toʻldirilgan Anketa Tizim operatori yoki Tizim roʻyxatga oluvchisining masʼul shaxsi tomonidan qabul qilinadi.</div></div><div class="BY_DEFAULT"><div name="-5205948" id="-5205948"></div></div><div class="ACT_TEXT"><div name="-5205950" id="-5205950">Jismoniy shaxs tomonidan elektron shaklda YIDXP orqali taqdim etilgan mobil qurilmani IMEI-kodlari, Anketa uning qabul qilinganligi toʻgʻrisidagi bildirishnoma bilan qabul qilinadi, shuningdek, roʻyxatga olish raqami berilgan holda YIDXPda avtomatik ravishda roʻyxatga olinadi. </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205951" id="-5205951">(30-bandning ikkinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli<a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198544"> qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-6649436" id="-6649436"></div></div><div class="ACT_TEXT"><div name="-6649439" id="-6649439">31. Jismoniy shaxslar tomonidan xalqaro pochta yoki kuryerlik joʻnatmalari orqali olib kiritilgan mobil qurilmalar Tizim operatori yoki Tizim roʻyxatga oluvchisiga shaxsan murojaat etish yoʻli bilan, shuningdek, tizim operatorining sayti orqali, mos ravishda pochta identifikatorining shtrix kodi, kalendar shtempeli boʻlgan konvert va joʻnatma oluvchining JSHSHIR mavjud shaxsni tasdiqlovchi hujjatini koʻrsatgan holda amalga oshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649444" id="-6649444">(31-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645786">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="BY_DEFAULT"><div name="-5205968" id="-5205968"></div></div><div class="BY_DEFAULT"><div name="-5205970" id="-5205970"></div></div><div class="BY_DEFAULT"><div name="-7426835" id="-7426835"></div></div><div class="ACT_TEXT"><div name="-7426839" id="-7426839">31<sup>1</sup>. Jismoniy shaxslarning Oʻzbekiston Respublikasi bojxona chegarasini kesib oʻtganligi toʻgʻrisidagi maʼlumotlar (sana, usul va boshqa) Oʻzbekiston Respublikasi Adliya vazirligi huzuridagi Personallashtirish agentligi bilan elektron axborot almashish orqali murojaat etilgan sana va pasport maʼlumotlarini qayd etilgan holda tekshiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-7426845" id="-7426845">(31<sup>1</sup>-bandning birinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2025-yil 1-martdagi 135-sonli <a href="https://lex.uz/ru/docs/-7410867?ONDATE=03.03.2025 00#-7412883">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 03.03.2025-y., 09/25/135/0208-son)</div></div><div class="ACT_TEXT"><div name="-5205972" id="-5205972">Xalqaro pochta joʻnatmalari maʼlumotlari tekshiruvi “Oʻzbekiston pochtasi” AJ, kuryerlik joʻnatmalari va BKO boʻyicha maʼlumotlari tekshiruvi Oʻzbekiston Respublikasi Davlat bojxona qoʻmitasi bilan elektron axborot almashinuvi orqali amalga oshiriladi. </div></div><div class="ACT_TEXT"><div name="-5205973" id="-5205973">Bojxona chegarasidan tovarlarni bojsiz olib kirish normalariga rioya qilinmagan holda olib kirilgan mobil qurilmalar, ular uchun import qiluvchi sifatida bojxona toʻlovlari toʻlangandan soʻng IMEI-kodlari roʻyxatdan oʻtkaziladi. </div></div><div class="ACT_TEXT"><div name="-5205975" id="-5205975">Jismoniy shaxslarning Oʻzbekiston Respublikasi bojxona chegarasini oxirgi marta kesib oʻtganligi toʻgʻrisidagi maʼlumotlar (sana, usul va boshqa) hisobga olinadi. </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5205978" id="-5205978">(31<sup>1</sup>-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198612">qaroriga </a>asosan kiritilgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-6649448" id="-6649448"></div></div><div class="ACT_TEXT"><div name="-6649451" id="-6649451">31<sup>2</sup>. Mobil qurilmalar belgilangan meʼyordan ortiq miqdorda olib kirilgan holatlarda yoki ularning bojxona rasmiylashtiruvidan oʻtganligi toʻgʻrisida hujjatlar taqdim etilmagan taqdirda, Tizim tomonidan ushbu mobil qurilmalarning modeliga muvofiq umumiy bojxona toʻlovlari hamda roʻyxatdan oʻtkazish toʻlovlari miqdori shakllantiriladi. </div></div><div class="ACT_TEXT"><div name="-6649453" id="-6649453">Bojxona toʻlovlari miqdori Bojxona qoʻmitasi maʼlumotlar bazasi bilan yoʻlga qoʻyilgan elektron axborot almashinuvi orqali belgilanadi. </div></div><div class="ACT_TEXT"><div name="-6649455" id="-6649455">Bunda jismoniy shaxs tomonidan toʻlangan bojxona toʻlovlari Davlat budjetiga, mobil qurilmani roʻyxatdan oʻtkazish uchun toʻlovlar Tizim operatorining mahsus hisobvaragʻiga yoʻnaltiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649465" id="-6649465">(31<sup>2</sup>-band Oʻzbekiston Respublikasi Vazirlar 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645788">qaroriga </a>asosan kiritilgan — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi) </div></div><div class="BY_DEFAULT"><div name="-5205999" id="-5205999"></div></div><div class="ACT_TEXT"><div name="-5206002" id="-5206002">32. Jismoniy shaxsdan ushbu Nizomda nazarda tutilmagan hujjatlar va maʼlumotlarning taqdim etishni talab qilishga yoʻl qoʻyilmaydi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5206006" id="-5206006">(32-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198633">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-4519023" id="-4519023"></div></div><div class="BY_DEFAULT"><div name="-5206013" id="-5206013"></div></div><div class="ACT_TEXT"><div name="-5206014" id="-5206014">33. Mobil qurilmalarni roʻyxatga olish uchun ushbu Nizomda<a href="https://lex.uz/ru/docs/4517458#4519015"> </a>nazarda tutilmagan qoʻshimcha maʼlumotlarni olish zarur boʻlganda, Tizim operatori Oʻzbekiston Respublikasi Vazirlar Mahkamasining “Tadbirkorlik subyektlariga davlat xizmatlari koʻrsatish tartibini yanada takomillashtirish chora-tadbirlari toʻgʻrisida” 2014-yil 31-dekabrdagi 377-son <a href="https://lex.uz/ru/docs/2534723">qarori</a> bilan belgilangan tartibda boshqa vakolatli organlardan mustaqil ravishda ularni soʻraydi va oladi. </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5206015" id="-5206015">(33-bandning birinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198633">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="ACT_TEXT"><div name="-4519026" id="-4519026">Mobil qurilmalarni roʻyxatga olish uchun zarur boʻlgan hujjatlari va axboroti mavjud boʻlgan davlat organlari tegishli idoralararo soʻrovni olgan paytdan boshlab bir ish kuni ichida bunday hujjatlar va axborotni (arxiv maʼlumotlaridan tashqari) taqdim etishga majbur. </div></div><div class="BY_DEFAULT"><div name="-5988338" id="-5988338"></div></div><div class="ACT_TEXT"><div name="-5988342" id="-5988342">34. Ishonchli boʻlmagan yoki notoʻgʻri maʼlumotlar taqdim etganligi uchun jismoniy shaxs qonunchilikka muvofiq javobgar boʻladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5988346" id="-5988346">(34-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2022-yil 4-apreldagi 153-sonli <a href="https://lex.uz/ru/docs/5936929?ONDATE=05.04.2022 00#5939974">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 05.04.2022-y., 09/22/153/0266-son)</div></div><div class="ACT_TEXT"><div name="-4519030" id="-4519030">35. Jismoniy shaxsning Anketasini koʻrib chiqish va mobil qurilmalarning IMEI-kodlarini roʻyxatga olish 3 (uch) ish soati ichida amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4519032" id="-4519032">36. Roʻyxatga olish tugaganidan keyin Tizim operatori yoki Tizim roʻyxatga oluvchisi 1 ish soati ichida belgilangan tartibda jismoniy shaxsga hisobni taqdim etadi.</div></div><div class="ACT_TEXT"><div name="-4519034" id="-4519034">37. Jismoniy shaxs tomonidan toʻlov amalga oshirilgandan keyin Tizim operatori yoki Tizim roʻyxatga oluvchisi 1 ish soati ichida barcha IMEI-kodlarni oq roʻyxatga kiritadi va agar mavjud boʻlsa, roʻyxatga olib boʻlmaydigan mobil qurilmalarning IMEI-kodlari roʻyxatini koʻrsatgan holda, jismoniy shaxsni anketada koʻrsatilgan usul orqali roʻyxatga olish tugaganligi toʻgʻrisida xabardor qiladi. </div></div><div class="BY_DEFAULT"><div name="-5206017" id="-5206017"></div></div><div class="ACT_TEXT"><div name="-5206022" id="-5206022">38. Roʻyxatga olish toʻgʻrisidagi Anketani koʻrib chiqish davrida, IMEI-kodning birinchi tarmoq hodisasi sodir etilgan vaqtidan keyin 30 kun ichida murojaat qilingan boʻlsa, jismoniy shaxsning mobil qurilmasi aloqa xizmatlarini cheklamasdan, kulrang roʻyxatda turadi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5206023" id="-5206023">(38-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198635">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-6649470" id="-6649470"></div></div><div class="ACT_TEXT"><div name="-6649473" id="-6649473">38<sup>1</sup>. Roʻyxatdan oʻtkazish uchun toʻlovlar ariza berilgan kundan boshlab oʻn kalendar kuni ichida amalga oshiriladi. </div></div><div class="ACT_TEXT"><div name="-6649475" id="-6649475">Toʻlovlar Oʻzbekiston Respublikasi qonunchiligida taqiqlanmagan usullar, shu jumladan, jismoniy shaxsning telefon raqami hisobidagi mablagʻdan amalga oshirilishi mumkin.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649478" id="-6649478">(38<sup>1</sup>-band Oʻzbekiston Respublikasi Vazirlar 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645792">qaroriga </a>asosan kiritilgan — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi) </div></div><div class="BY_DEFAULT"><div name="-4519039" id="-4519039"></div></div><div class="BY_DEFAULT"><div name="-5206126" id="-5206126"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5206128" id="-5206128">6-bob. Mobil qurilmalarda klonlangan IMEI-kodlar aniqlanganida tizimning ishlash tartibi</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5206131" id="-5206131">(6-bobning nomi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198640">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="BY_DEFAULT"><div name="-5206132" id="-5206132"></div></div><div class="ACT_TEXT"><div name="-5206135" id="-5206135">39. Mobil qurilmalarda klonlangan IMEI-kodlar aniqlangan taqdirda, tizim tomonidan avtomatik tarzda tahlil qilinadi va “qora roʻyxat”ga kiritiladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5206137" id="-5206137">(39-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198646">qarori </a>tahririda — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5206143" id="-5206143">(40-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198654">qaroriga </a>asosan oʻz kuchini yoʻqotgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5206145" id="-5206145">(41-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2020-yil 31-dekabrdagi 828-sonli <a href="https://lex.uz/ru/docs/-5193562?ONDATE=31.12.2020 00#-5198654">qaroriga </a>asosan oʻz kuchini yoʻqotgan — Qonun hujjatlari maʼlumotlari milliy bazasi, 31.12.2020-y., 09/20/828/1692-son)</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4519047" id="-4519047">7-bob. Mobil qurilmalarning IMEI-kodlarini roʻyxatga olish uchun toʻlov</div></div><div class="ACT_TEXT"><div name="-4519049" id="-4519049">42. Tizimda roʻyxatga olinishi kerak boʻlgan mobil qurilmalarning IMEI-kodlarini roʻyxatga olish uchun toʻlov miqdorlari ushbu Nizomga<a href="https://lex.uz/ru/docs/-4517458#-4519241"> 6-ilovada </a>keltirilgan.</div></div><div class="BY_DEFAULT"><div name="-6649480" id="-6649480"></div></div><div class="ACT_TEXT"><div name="-6649482" id="-6649482">43. Mobil qurilmalarning IMEI-kodlarini roʻyxatga olish uchun toʻlov Tizim operatorining maxsus hisobvaragʻiga kelib tushadi. </div></div><div class="ACT_TEXT"><div name="-6649486" id="-6649486">Kelib tushgan mablagʻlar quyidagilarga yoʻnaltiriladi: </div></div><div class="ACT_TEXT"><div name="-6649487" id="-6649487">tizim operatori oʻz faoliyatini yuritish xarajatlari va majburiyatlari uchun; </div></div><div class="ACT_TEXT"><div name="-6649491" id="-6649491">Oʻzbekiston Respublikasi Raqamli texnologiyalar vazirligining qaror, buyruq va farmoyishlariga asosan davlat organlarida amalga oshirilayotgan axborot-kommunikatsiya texnologiyalarini joriy etish loyihalarini maqsadli moliyalashtirish uchun (ushbu xarajatlarga Tizim operatorining investitsiya faoliyatidan olingan daromadlari ham jalb qilinishi mumkin); </div></div><div class="ACT_TEXT"><div name="-6649493" id="-6649493">Raqamli texnologiyalarni rivojlantirish jamgʻarmasiga — Vazirlar Mahkamasining qarorlariga muvofiq davlat organlarida amalga oshirilayotgan axborot-kommunikatsiya texnologiyalarini joriy etish loyihalarini maqsadli moliyalashtirish uchun; </div></div><div class="ACT_TEXT"><div name="-6649495" id="-6649495">respublika telekommunikatsiya infratuzilmasini, shu jumladan, qishloq va chekka aholi punktlari, turistik va rekreatsion hududlarda rivojlantirish loyihalari uchun.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649503" id="-6649503">(43-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645795">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="ACT_TEXT"><div name="-4519052" id="-4519052">44. Mobil qurilmada bittadan ortiq IMEI kodi boʻlgan taqdirda, roʻyxatga olish toʻlovi har bir IMEI-kod uchun alohida amalga oshiriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4519054" id="-4519054">8-bob. Tizim operatorining huquqlari, majburiyatlari va javobgarligi</div></div><div class="ACT_TEXT"><div name="-4519055" id="-4519055">45. Tizim operatori quyidagi huquqlarga ega:</div></div><div class="ACT_TEXT"><div name="-4519057" id="-4519057">Tizimga kira olish va undan foydalanish tartibini belgilash;</div></div><div class="ACT_TEXT"><div name="-4519059" id="-4519059">axborot almashish uchun belgilangan tartibda Tizimning boshqa axborot tizimlari bilan integratsiyalashuvini amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-4519060" id="-4519060">mobil aloqa operatorlaridan zarur texnik axborotni, shu jumladan mobil qurilmaning ishlash maʼlumotlarini, real vaqt rejimida mobil qurilma, shuningdek, tizim ishlashi doirasida belgilangan davriylik bilan amalga oshirilgan tarmoq hodisalari va aktivlik parametrlarini soʻrash;</div></div><div class="ACT_TEXT"><div name="-4519062" id="-4519062">mobil aloqa operatorlarining mablagʻlari hisobidan Tizimning ishlashi doirasida zarur ishlarni bajarish boʻyicha mobil aloqa operatorlarining faoliyatini muvofiqlashtirish;</div></div><div class="ACT_TEXT"><div name="-4519065" id="-4519065">mobil aloqa operatorlarining tarmoqlaridagi Tizimning ishlashiga taʼsir koʻrsatuvchi kamchiliklarni ularning mablagʻlari hisobidan bartaraf etish boʻyicha mobil aloqa operatorlarining faoliyatini muvofiqlashtirish.</div></div><div class="BY_DEFAULT"><div name="-5988356" id="-5988356"></div></div><div class="ACT_TEXT"><div name="-5988358" id="-5988358">Tizim operatori qonunchilikka muvofiq boshqa huquqlarga ham ega boʻlishi mumkin.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5988362" id="-5988362">(45-bandning yettinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2022-yil 4-apreldagi 153-sonli <a href="https://lex.uz/ru/docs/5936929?ONDATE=05.04.2022 00#5939974">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 05.04.2022-y., 09/22/153/0266-son)</div></div><div class="BY_DEFAULT"><div name="-6649510" id="-6649510"></div></div><div class="ACT_TEXT"><div name="-6649512" id="-6649512">Taqdim qilingan maʼlumotlari toʻgʻri kelmagan, uchinchi shaxslarning maʼlumotlari taqdim qilingan hollarda IMEI-kodlarni roʻyxatdan oʻtkazishni rad etish.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649518" id="-6649518">(45-bandning sakkizinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645802">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="ACT_TEXT"><div name="-4519070" id="-4519070">46. Tizim operatori quyidagilarga majbur:</div></div><div class="ACT_TEXT"><div name="-4519072" id="-4519072">mobil aloqa operatorlari bilan birgalikda Tizim modullarini ularning axborot tizimlariga integratsiyalashtirish;</div></div><div class="ACT_TEXT"><div name="-4519076" id="-4519076">Tizimning uzluksiz ishlashi va axborot xavfsizligini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-4519077" id="-4519077">mobil aloqa operatorlarini Tizimning texnik nosozliklari toʻgʻrisida oʻz vaqtida xabardor qilish;</div></div><div class="BY_DEFAULT"><div name="-6649531" id="-6649531"></div></div><div class="ACT_TEXT"><div name="-6649533" id="-6649533">tizimda roʻyxatga olingan xorijdan olib kelingan mobil qurilmalar toʻgʻrisida Bojxona qoʻmitasiga har oy yakuni boʻyicha axborot taqdim etish; </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6649539" id="-6649539">(46-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 26-oktabrdagi 563-sonli <a href="https://lex.uz/ru/docs/-6645422?ONDATE=28.01.2024 00#-6645805">qaroriga </a>asosan beshinchi xatboshi bilan toʻldirilgan — Qonunchilik maʼlumotlari milliy bazasi, 27.10.2023-y., 09/23/563/0800-son — 2024-yil 28-yanvardan kuchga kiradi)</div></div><div class="BY_DEFAULT"><div name="-5988366" id="-5988366"></div></div><div class="ACT_TEXT"><div name="-5988367" id="-5988367">Tizim operatori qonunchilikka muvofiq boshqa majburiyatlarni ham bajarishi mumkin.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5988368" id="-5988368">(46-bandning beshinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2022-yil 4-apreldagi 153-sonli <a href="https://lex.uz/ru/docs/5936929?ONDATE=05.04.2022 00#5939974">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 05.04.2022-y., 09/22/153/0266-son)</div></div><div class="ACT_TEXT"><div name="-4519080" id="-4519080">47. Tizim operatori quyidagilarga javobgar boʻladi:</div></div><div class="ACT_TEXT"><div name="-4519083" id="-4519083">Tizimning uzluksiz ishlashi va axborot xavfsizligi;</div></div><div class="ACT_TEXT"><div name="-4519086" id="-4519086">maxfiy axborotni tarqatmaslik va ularni muhofaza qilish boʻyicha zarur chora-tadbirlarning oʻz vaqtida amalga oshirilishi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4519088" id="-4519088">9-bob. Boshqa idoralar bilan oʻzaro hamkorlik</div></div><div class="ACT_TEXT"><div name="-4519091" id="-4519091">48. Tizimning boshqa idoralar va manfaatdor tashkilotlar bilan axborot almashish tartibi va oʻzaro hamkorlik qilish shartlari tashkilotlar hamda Oʻzbekiston Respublikasi Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi oʻrtasida tuzilgan oʻzaro hamkorlik boʻyicha alohida shartnomalar/kelishuvlar bilan belgilanadi. </div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4519093" id="-4519093">10-bob. Yakunlovchi qoidalar</div></div><div class="ACT_TEXT"><div name="-4519097" id="-4519097">49. Davlatning, huquqni muhofaza qilish organlarining xavfsizligi va mudofaa qobiliyatini taʼminlash hamda oʻta muhim ijtimoiy-siyosiy chora-tadbirlarni oʻtkazishda Tizim operatori huquqni muhofaza qilish organlarining soʻrovi boʻyicha mobil qurilmalar ishini majburiy toʻxtatib turish va qayta tiklashni amalga oshiradi.</div></div><div class="BY_DEFAULT"><div name="-5206160" id="-5206160"></div></div><div class="ACT_TEXT"><div name="-5206162" id="-5206162">49<sup>1</sup>. Tizim operatori Tizimdan foydalanish yoʻli bilan shartnoma asosida Oʻzbekiston Respublikasi qonunchiligida taqiqlanmagan xizmatlarni taqdim qilish huquqiga ega. </div></div><div class="BY_DEFAULT"><div name="-7834781" id="-7834781"></div></div><div class="ACT_TEXT"><div name="-7834783" id="-7834783">49<sup>2</sup>. Ushbu Nizomda ariza beruvchiga yoki taqdim etilgan hujjatlar va maʼlumotlarga belgilangan talablarning buzilishi aniqlanganda yoki shunday holatlar toʻgʻrisida shaxslardan kelib tushgan murojaatlarga asosan avval roʻyxatdan oʻtkazilgan IMEI-kodlar sudning tegishli qaroriga asosan Tizim operatori tomonidan bekor qilinadi va amalga oshirilgan xizmatlar uchun qabul qilingan toʻlovlar qaytarilmaydi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-7834789" id="-7834789">(49<sup>2</sup>-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2025-yil 6-noyabrdagi 700-sonli <a href="https://lex.uz/ru/docs/-7816457?ONDATE=08.02.2026 00#-7827152">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 07.11.2025-y., 09/25/700/1022-son. Kuchga kirish sanasi — 2026-yil 8-fevral)</div></div><div class="BY_DEFAULT"><div name="-7834791" id="-7834791"></div></div><div class="ACT_TEXT"><div name="-7834793" id="-7834793">49<sup>3</sup>. Ariza beruvchi va jismoniy shaxslar mazkur Nizom talablari buzilishi oqibatida tizim operatori, tizim roʻyxatga oluvchisi va boshqa vakolatli davlat organlari mansabdor shaxslarining qabul qilgan qarorlari yoki sodir qilgan harakatlari (harakatsizligi) ustidan qonunchilikda belgilangan tartibda shikoyat qilish huquqiga ega.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-7834881" id="-7834881">(49<sup>3</sup>-band Oʻzbekiston Respublikasi Vazirlar 2025-yil 6-noyabrdagi 700-sonli <a href="https://lex.uz/ru/docs/-7816457?ONDATE=08.02.2026 00#-7827154">qaroriga </a>asosan kiritilgan — Qonunchilik maʼlumotlari milliy bazasi, 07.11.2025-y., 09/25/700/1022-son. Kuchga kirish sanasi — 2026-yil 8-fevral) )</div></div><div class="BY_DEFAULT"><div name="-5988369" id="-5988369"></div></div><div class="ACT_TEXT"><div name="-5988370" id="-5988370">50. Ushbu Nizomning talablarini buzganlikda aybdor shaxslar qonunchilikda belgilangan tartibda javobgar boʻladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-5988371" id="-5988371">(50-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2022-yil 4-apreldagi 153-sonli <a href="https://lex.uz/ru/docs/5936929?ONDATE=05.04.2022 00#5939974">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 05.04.2022-y., 09/22/153/0266-son)</div></div><div class="BY_DEFAULT"><div name="-4519102" id="-4519102"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4519104" id="-4519104">Oʻzbekiston Respublikasi hududida foydalanilayotgan, sotish yoki shaxsiy foydalanish uchun olib kiriladigan va ishlab chiqariladigan mobil qurilmalarni roʻyxatga olish tartibi toʻgʻrisidagi <a href="https://lex.uz/ru/docs/-4517458#-4518702">nizomga</a> <br />1-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-4519105" id="-4519105">Mobil qurilmalarni xalqaro oʻziga xos identifikatsiya kodlari boʻyicha roʻyxatga olish tizimida roʻyxatga olinishi kerak boʻlgan mobil qurilmalar turlari</div></div><div class="ACT_FORM"><div name="-4519107" id="-4519107">ROʻYXATI</div></div><div class="BY_DEFAULT"><div name="-4519109" id="-4519109"></div></div><div class="BY_DEFAULT"><div name="-4519110" id="-4519110"><table style="BORDER-RIGHT: medium none;BORDER-TOP: medium none;BORDER-LEFT: medium none;BORDER-BOTTOM: medium none;BORDER-COLLAPSE: collapse" cellspacing="0" cellpadding="0" width="99%" border="1">
<tbody>
<tr style="HEIGHT: 1cm;page-break-inside: avoid">
<td style="BORDER-RIGHT: windowtext 1pt solid;PADDING-RIGHT: 5.4pt;BORDER-TOP: windowtext 1pt solid;PADDING-LEFT: 5.4pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: windowtext 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: windowtext 1pt solid;HEIGHT: 1cm" width="6%">
<p align="center"><b><span style="COLOR: black">T/r</span></b></p></td>
